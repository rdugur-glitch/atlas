# ATLAS ortam değişkenleri — örnek dosya. Gerçek değerleri buraya YAZMAYIN;
# platformun secret ayarlarına veya commit edilmeyen bir .env dosyasına koyun.

# --- API sunucusu (artifacts/api-server) ---
# Production'da bu üçü eksikse sunucu açık bir hatayla başlamaz.
DATABASE_URL=postgres://kullanici:sifre@host:5432/atlas
# Oturum çerezi imzası VE kayıtlı Claude anahtarlarının AES-256-GCM şifrelemesi.
# Mevcut şifreli kayıtlar varsa bu değeri DEĞİŞTİRMEYİN; değişirse anahtarlar okunamaz.
SESSION_SECRET=
# Clerk (hesap doğrulaması). Zorunlu.
CLERK_SECRET_KEY=
# Clerk publishable key. Geliştirme (pk_test_) anahtarında gerekir; canlı ortamda
# boş bırakılırsa istek alan adından (clerk.<alan-adı>) türetilir.
CLERK_PUBLISHABLE_KEY=
PORT=8080
# NODE_ENV=production   # production modunda API, derlenmiş web uygulamasını da sunar
# LOG_LEVEL=info

# --- Web uygulaması (artifacts/atlas) — derleme sırasında okunur ---
VITE_CLERK_PUBLISHABLE_KEY=
# İsteğe bağlı: Clerk Frontend API proxy adresi (örn. https://alan-adi/api/__clerk)
VITE_CLERK_PROXY_URL=
BASE_PATH=/
# PORT dev/preview sunucusu için de zorunludur (örn. 20388)

# Not: Claude (Anthropic) anahtarı ortam değişkeni DEĞİLDİR; her kullanıcı kendi
# anahtarını uygulamadaki Ayarlar ekranından girer ve şifreli saklanır.
